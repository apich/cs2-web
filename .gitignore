# 依赖包
node_modules/

# 编译构建输出
dist/
artifacts/
output/

# 核心 3D 地图、模型与音效大文件（约 200MB，通过 npm run assets:fetch 按需下载，避免撑爆 Git 仓库）
public/assets/

# 本地运行缓存与自动化测试浏览器
.runtime/
.playwright-cli/
.playwright/
coverage/
.nyc_output/

# 日志与临时下载切片
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.part
*.tmp

# 环境变量与证书密钥（防止敏感凭据泄露）
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# 编辑器与 IDE 临时配置
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 操作系统自动生成的系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Python 缓存
scripts/integrate-controls.py
__pycache__/
*.pyc

# Android 移动端构建产物与签名私钥
android/.gradle/
android/**/build/
android/local.properties
android/signing/
*.jks
*.keystore
public/downloads/*.apk
public/downloads/android-latest.json
